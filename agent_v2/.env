# ============================================================
#  Singurul fisier pe care il editezi.
#  Asa cum e acum, e pregatit pentru SERVER.
# ============================================================

# --- Mapa cu documentele tale --------------------------------
# Orice structura de subfoldere. PDF, text, markdown, HTML, cod - orice.
DOCS_DIR=/root/documentatie

# --- Modelul -------------------------------------------------
# MODELS_DIR     = mapa in care stau fisierele .gguf pe server
# LLM_MODEL_FILE = numele exact al fisierului din acea mapa
#
# Daca nu esti sigur ce ai acolo:   ls -lh /opt/agent/models/
MODELS_DIR=/opt/agent/models
LLM_MODEL_FILE=Qwen3-30B-A3B-Instruct-2507-Q4_K_M.gguf

# --- CPU -----------------------------------------------------
# THREADS = nuclee FIZICE, nu fire. Mai multe decat atat = mai LENT.
# Vezi cate ai:   lscpu | grep -E "^CPU\(s\)|Core\(s\) per socket|Socket"
THREADS=80

# Contextul. Mai mare = mai multa documentatie deodata, dar mai multa RAM
# si prefill mai lent.
CTX=16384

# --- Reglaje fine (le poti lasa asa) -------------------------
# Sub acest scor, intrebarea e tratata ca discutie normala, nu ca
# intrebare despre documente. Mai mare = mai rar intra in documentatie.
DOC_MIN_SCORE=0.5

# Cate fragmente de documentatie trimite modelului la fiecare intrebare.
TOP_K=8

# Lungimea maxima a raspunsului.
MAX_TOKENS=1024

# Limbile pentru OCR-ul PDF-urilor scanate.
OCR_LANGS=ron+eng+rus
