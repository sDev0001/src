# ============================================================
#  Configuratie agent RAG local  --  100% offline, CPU only
#  Nu trebuie sa modifici nimic aici. Totul se detecteaza singur.
#  Suprascrii orice din shell:  LLM_MODEL=/alt/model.gguf ./start.sh
# ============================================================

export AGENT_HOME="${AGENT_HOME:-/opt/agent}"

# --- Locale: obligatoriu pe consola minimala, altfel Python crapa la diacritice
export LANG="${LANG:-C.UTF-8}"
export LC_ALL="${LC_ALL:-C.UTF-8}"
export PYTHONIOENCODING=utf-8
export PYTHONUNBUFFERED=1

# --- Foldere (se creeaza singure) ---------------------------
export DOCS_DIRS="$AGENT_HOME/docs/pdf:$AGENT_HOME/docs/repos:$AGENT_HOME/docs/md"
export DATA_DIR="$AGENT_HOME/data"
mkdir -p "$AGENT_HOME"/{models,data,logs,bin} \
         "$AGENT_HOME"/docs/{pdf,repos,md} 2>/dev/null || true

# --- Binarul llama.cpp: cauta in locurile obisnuite ----------
if [ -z "${LLAMA_BIN:-}" ]; then
  for d in "$AGENT_HOME/llama.cpp/build/bin" \
           "$HOME/llama.cpp/build/bin" \
           "/root/llama.cpp/build/bin" \
           "/opt/llama.cpp/build/bin" \
           "/usr/local/bin" "/usr/bin"; do
    if [ -x "$d/llama-server" ]; then LLAMA_BIN="$d"; break; fi
  done
fi
export LLAMA_BIN="${LLAMA_BIN:-$AGENT_HOME/llama.cpp/build/bin}"

# --- Model de embeddings: primul bge-m3*.gguf gasit ----------
if [ -z "${EMB_MODEL:-}" ]; then
  EMB_MODEL="$(ls -1 "$AGENT_HOME"/models/*bge-m3*.gguf 2>/dev/null | head -1)"
fi
export EMB_MODEL="${EMB_MODEL:-$AGENT_HOME/models/bge-m3-Q8_0.gguf}"

# --- Model LLM: orice .gguf care NU e cel de embeddings ------
#     Prioritate: Qwen3-30B-A3B (MoE, cel mai rapid pe CPU) > 14B > orice altceva
if [ -z "${LLM_MODEL:-}" ]; then
  for pat in '*30B-A3B*' '*30b-a3b*' '*Qwen3*14B*' '*qwen*' '*'; do
    LLM_MODEL="$(ls -1S "$AGENT_HOME"/models/$pat.gguf /opt/models/$pat.gguf 2>/dev/null \
                 | grep -vi 'bge\|embed\|e5-\|rerank' | head -1)"
    [ -n "$LLM_MODEL" ] && break
  done
fi
export LLM_MODEL="${LLM_MODEL:-$AGENT_HOME/models/Qwen3-30B-A3B-Instruct-2507-Q4_K_M.gguf}"

# --- Servere ------------------------------------------------
export LLM_PORT="${LLM_PORT:-8080}"
export EMB_PORT="${EMB_PORT:-8081}"
export LLM_URL="http://127.0.0.1:$LLM_PORT"
export EMB_URL="http://127.0.0.1:$EMB_PORT"

# Context. 16k ajunge pentru RAG. Mai mare = mai multa RAM pe KV-cache.
export CTX="${CTX:-16384}"
export EMB_CTX="${EMB_CTX:-8192}"
export EMB_UBATCH="${EMB_UBATCH:-2048}"   # chunk-urile noastre au ~400 tokeni

# --- CPU ----------------------------------------------------
# Threads = NUCLEE FIZICE. Mai multe decat atat => mai LENT, nu mai rapid.
if [ -z "${THREADS:-}" ]; then
  THREADS="$(lscpu -p=Core,Socket 2>/dev/null | grep -v '^#' | sort -u | wc -l | tr -d ' ')"
  case "$THREADS" in ''|*[!0-9]*|0) THREADS="$(nproc)" ;; esac
fi
export THREADS
export THREADS_BATCH="${THREADS_BATCH:-$(nproc)}"   # citirea promptului: toate
export NGL="${NGL:-0}"                              # 0 = fara GPU
export USE_MLOCK="${USE_MLOCK:-1}"                  # tine modelul in RAM, fara swap

# --- Flaguri optionale: le folosim doar daca build-ul tau le suporta
if [ -z "${EXTRA_LLM_FLAGS:-}" ]; then
  _cache="$AGENT_HOME/data/.llama_flags"
  if [ -f "$_cache" ] && [ "$_cache" -nt "$LLAMA_BIN/llama-server" ] 2>/dev/null; then
    EXTRA_LLM_FLAGS="$(cat "$_cache")"
  elif [ -x "$LLAMA_BIN/llama-server" ]; then
    _h="$("$LLAMA_BIN/llama-server" --help 2>&1 || true)"
    EXTRA_LLM_FLAGS=""
    case "$_h" in *--jinja*)         EXTRA_LLM_FLAGS="$EXTRA_LLM_FLAGS --jinja" ;; esac
    case "$_h" in *--cont-batching*) EXTRA_LLM_FLAGS="$EXTRA_LLM_FLAGS --cont-batching --parallel 2" ;; esac
    printf '%s' "$EXTRA_LLM_FLAGS" > "$_cache" 2>/dev/null || true
  fi
fi
export EXTRA_LLM_FLAGS="${EXTRA_LLM_FLAGS:-}"

# --- Chunking / cautare -------------------------------------
export CHUNK_CHARS="${CHUNK_CHARS:-1100}"
export CHUNK_OVERLAP="${CHUNK_OVERLAP:-180}"
export EMB_BATCH="${EMB_BATCH:-16}"
export TOP_K="${TOP_K:-8}"
export CAND_K="${CAND_K:-40}"
export OCR_LANGS="${OCR_LANGS:-ron+eng+rus}"

# --- Generare -----------------------------------------------
export TEMPERATURE="${TEMPERATURE:-0.2}"
export MAX_TOKENS="${MAX_TOKENS:-1024}"
